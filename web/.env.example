# Supabase — from dashboard (see docs/SUPABASE_SETUP_CHECKLIST.md section C).

# Base URL (not on the API Keys page). Find via:
# Settings → General, or Overview → Connect, or use https://YOUR_PROJECT_REF.supabase.co from the dashboard URL.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"

# Legacy anon JWT: Settings → API Keys → tab "Legacy anon, service_role" → anon public (starts with eyJ).
# Not the sb_publishable_ / sb_secret_ keys unless you deliberately migrate the app.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
